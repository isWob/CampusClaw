# ── CampusClaw 迭代 1 本地/Compose 环境变量示例 ──
# 复制为 .env 后按需修改：cp .env.example .env
# 本文件入库（仅含占位/演示值）；.env 被 git 忽略，绝不入库。

# Flask 会话签名密钥（必填，无内置默认；缺失则拒绝启动）
# 生产环境请替换为随机长字符串，例如：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# 预置账号口令（必填，仅用于课程演示；缺失则拒绝启动）
SEED_TEACHER_A_PASSWORD=teacher-a-123
SEED_STUDENT_A1_PASSWORD=student-a1-123
SEED_STUDENT_B1_PASSWORD=student-b1-123

# 上传大小上限（字节），默认 5242880 = 5 MiB
MAX_UPLOAD_BYTES=5242880

# JWT 有效期（秒），默认 3600 = 1 小时
JWT_EXPIRES=3600

# Compose 映射到宿主机的端口（容器内固定 8000）
WEB_PORT=8080

# 以下两项在 docker-compose.yml 中固定为容器卷路径 /data/...
# 仅在脱离容器直接本地运行时需要自定义：
# DATABASE_PATH=./data/campusclaw.db
# UPLOAD_DIR=./data/uploads

# 知识库检索（均可选；缺失时 keyword 可用，vector/hybrid 返回 503）
# QDRANT_URL=http://localhost:6333
# EMBEDDING_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
# EMBEDDING_API_KEY=your-key
# EMBEDDING_MODEL=bge-small-zh-v1.5
# CHAT_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
# CHAT_API_KEY=your-key
# CHAT_MODEL=gpt-4o-mini
# TUTOR_TOP_K=4
# TUTOR_MAX_HISTORY=6
